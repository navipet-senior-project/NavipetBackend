{
  "name": "navipet-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "campus-places:apply": "tsx scripts/import-campus-places.ts --apply --approved",
    "campus-places:dry-run": "tsx scripts/import-campus-places.ts",
    "campus-coordinates:apply": "tsx scripts/enrich-campus-coordinates.ts --apply --approved",
    "campus-coordinates:dry-run": "tsx scripts/enrich-campus-coordinates.ts",
    "concept3d:dry-run": "tsx scripts/import-concept3d-coordinates.ts",
    "concept3d:apply": "tsx scripts/import-concept3d-coordinates.ts --apply --approved",
    "import:concept3d": "tsx scripts/import-concept3d-coordinates.ts --apply --approved",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "@supabase/supabase-js": "2.112.4",
    "dotenv": "18.0.3",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.2",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
